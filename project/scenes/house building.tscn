r size_values = size_str.split(\\\"×\\\")\\n\\t\\t\\t\\twall_info.size = Vector3(\\n\\t\\t\\t\\t\\tfloat(size_values[0]),\\n\\t\\t\\t\\t\\t2.5,\\n\\t\\t\\t\\t\\tfloat(size_values[1])\\n\\t\\t\\t\\t)\\n\\t\\t\\t\\n\\t\\t\\twall_data.append(wall_info)\\n\\t\\n\\t# Create nodes for each wall\\n\\tfor wall in wall_data:\\n\\t\\tvar wall_node = MeshInstance3D.new()\\n\\t\\twall_node.name = \\\"Wall_\\\" + wall.name\\n\\t\\t\\n\\t\\t# Set the mesh (using a box mesh for simplicity)\\n\\t\\tvar mesh = BoxMesh.new()\\n\\t\\tmesh.size = wall.size\\n\\t\\twall_node.mesh = mesh\\n\\t\\t\\n\\t\\t# Set position\\n\\t\\twall_node.position = wall.position\\n\\t\\t\\n\\t\\t# Set owner to the scene root node's owner, not this AI node\\n\\t\\tvar scene_root = node.get_tree().get_root()\\n\\t\\tif scene_root and scene_root.owner:\\n\\t\\t\\twall_node.owner = scene_root.owner\\n\\t\\t\\n\\t\\t# Add as child to the current node (or its owner if needed)\\n\\t\\tnode.add_child(wall_node)\\n\\t\\twall_node.set_owner(node.owner)\\n\\t\\n\\tprint(\\\"Created \\\" + str(wall_data.size()) + \\\" wall nodes\\\")\"}",
