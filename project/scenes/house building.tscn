"description": "Move a node by an offset in world space.",
"name": "translate_node",
"parameters": {
"properties": {
"node_path": {
"description": "Path to the node",
"type": "string"
},
"offset_x": {
"description": "Offset X in world space",
"type": "number"
},
"offset_y": {
"description": "Offset Y in world space",
"type": "number"
},
"offset_z": {
"description": "Offset Z in world space",
"type": "number"
}
},
"type": "object"
}
},
"type": "function"
}, {
