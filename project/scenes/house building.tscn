[node name="CreateWallSkill" type="Node" parent="Implementer AI" unique_id=1154835239]
script = ExtResource("5_guxr7")
description = "Creates a 3D wall with configurable openings (doors/windows)."
definition = "
		This skill provides tools to create and modify 3D walls.
		
		- create_wall: Creates axis-aligned walls (X or Z) at Y=0. Walls are 2.5m high.
		- add_opening_to_wall: Adds an opening to an existing wall by name.
		- delete_wall: Deletes an existing wall or node.
		
		Openings:
		- doors: default 2.1m high, custom width. Default starts at Y=0.
		- windows: default 1.2m high, custom width. Default starts at Y=0.8m.
		- (Optional) height: Custom height for the opening.
		- (Optional) y_offset: Custom vertical distance from the floor.
		
		CRITICAL RULES FOR AI:
		1. start_position is the END/CORNER of the wall, NOT the center of a room! Do not use room centroids as start_position.
		2. direction determines which axis the wall runs along. Ensure 'length' matches the dimension of the wall along that axis (do not swap width/depth).
		3. To perfectly center an opening on the wall, calculate: offset = (wall_length - opening_width) / 2.0
	"
tools = Array[Dictionary]([{
"function": {
"description": "Generates a 3D wall node in the scene.",
"name": "create_wall",
"parameters": {
"properties": {
"direction": {
"enum": ["+X", "-X", "+Z", "-Z"],
"type": "string"
},
"length": {
"type": "number"
},
"name": {
"description": "The name of the wall node",
"type": "string"
},
"openings": {
"items": {
"properties": {
"height": {
"description": "Optional custom height",
"type": "number"
},
"offset": {
"description": "Position relative to start",
"type": "number"
},
"type": {
"enum": ["door", "window"],
"type": "string"
},
"width": {
"type": "number"
},
"y_offset": {
"description": "Optional vertical offset from floor",
"type": "number"
}
},
"type": "object"
},
"type": "array"
},
"start_position": {
"description": "Start [x, y, z]",
"items": {
"type": "number"
},
"type": "array"
},
"thickness": {
"type": "number"
}
},
"required": ["name", "start_position", "direction", "length", "thickness"],
"type": "object"
}
},
"type": "function"
}, {
"function": {
"description": "Adds a new opening (door/window) to an existing wall.",
"name": "add_opening_to_wall",
"parameters": {
"properties": {
"opening": {
"properties": {
"height": {
"description": "Optional custom height",
"type": "number"
},
"offset": {
"description": "Position relative to start",
"type": "number"
},
"type": {
"enum": ["door", "window"],
"type": "string"
},
"width": {
"type": "number"
},
"y_offset": {
"description": "Optional vertical offset from floor",
"type": "number"
}
},
"required": ["type", "offset", "width"],
"type": "object"
},
"wall_name": {
"description": "The name of the existing wall node",
"type": "string"
}
},
"required": ["wall_name", "opening"],
"type": "object"
}
},
"type": "function"
}, {
"function": {
"description": "Deletes a wall or node by its name or relative path.",
"name": "delete_wall",
"parameters": {
"properties": {
"node_identifier": {
"description": "The name of the wall node (searched under 'Generated') or a relative path from the AI node.",
"type": "string"
}
},
"required": ["node_identifier"],
"type": "object"
}
},
"type": "function"
}])
metadata/_custom_type_script = "uid://cxdt17r23o083"

[node name="ExtractWallsRoomsSkill" type="Node" parent="Implementer AI" unique_id=1869268693]
script = ExtResource("4_41go7")
description = "Extracts walls and rooms information from the scene including positions, sizes, and relationships."
definition = "
		This skill extracts detailed information about walls and rooms in a 3D house blueprint scene.
		It can extract position, size, rotation data for each wall and room, as well as connection information.
		When called, it returns structured data about all walls and rooms in the BlueprintReference node.
	"
tools = Array[Dictionary]([{
"function": {
"description": "Extracts position, size, and metadata for all walls and rooms in the scene",
"name": "extract_walls_rooms_data",
"parameters": {
"properties": {
"format": {
"default": "text",
"description": "Output format: 'text' or 'json'",
"type": "string"
},
"include_details": {
"description": "Whether to include detailed metadata about each element",
"type": "boolean"
}
},
"required": [],
"type": "object"
}
},
"type": "function"
}, {
"function": {
"description": "Validates the extracted walls and rooms data for consistency and correctness",
"name": "validate_walls_rooms",
"parameters": {
"properties": {},
"required": [],
"type": "object"
}
},
"type": "function"
}, {
"function": {
"description": "Exports the walls and rooms data to JSON format",
"name": "export_walls_rooms_json",
"parameters": {
"properties": {
"file_path": {
"description": "Path where to save the JSON file",
"type": "string"
}
},
"required": [],
"type": "object"
}
},
"type": "function"
}])
metadata/_custom_type_script = "uid://3twea7kpcupj"

