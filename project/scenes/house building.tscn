"arguments": "{\"path\":\"res://ai_skills/scripts/extract_positions.gd\",\"target_line\":180,\"old_content\":\"\\t]\",\"new_content\":\"\\t]\\n\\n\\t# Implementations of the tools:\\n\\n\\tfunc extract_global_position(node_or_path: Variant) -> Vector3:\\n\\t\\tif node_or_path is Node:\\n\\t\\t\\treturn node_or_path.get_global_transform().origin\\n\\t\\tvar path := str(node_or_path)\\n\\t\\tvar node := get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_warning(\\\"Node not found at path: \\\" + path)\\n\\t\\t\\treturn Vector3.ZERO\\n\\t\\treturn node.get_global_transform().origin\\n\\n\\tfunc extract_local_position(node_or_path: Variant) -> Vector3:\\n\\t\\tif node_or_path is Node:\\n\\t\\t\\treturn node_or_path.position\\n\\t\\tvar path := str(node_or_path)\\n\\t\\tvar node := get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_warning(\\\"Node not found at path: \\\" + path)\\n\\t\\t\\treturn Vector3.ZERO\\n\\t\\treturn node.position\\n\\n\\tfunc get_transform_info(node_or_path: Variant) -> Dictionary:\\n\\t\\tif node_or_path is Node:\\n\\t\\t\\tvar transform := node_or_path.get_transform()\\n\\t\\t\\treturn {\\n\\t\\t\\t\\t\\\"position\\\": node_or_path.position,\\n\\t\\t\\t\\t\\\"rotation\\\": transform.basis.get_rotation_quaternion(),\\n\\t\\t\\t\\t\\\"scale\\\": transform.basis.get_scale(),\\n\\t\\t\\t\\t\\\"basis\\\": transform.basis\\n\\t\\t\\t}\\n\\t\\tvar path := str(node_or_path)\\n\\t\\tvar node := get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_warning(\\\"Node not found at path: \\\" + path)\\n\\t\\t\\treturn {}\\n\\t\\tvar transform := node.get_transform()\\n\\t\\treturn {\\n\\t\\t\\t\\\"position\\\": node.position,\\n\\t\\t\\t\\\"rotation\\\": transform.basis.get_rotation_quaternion(),\\n\\t\\t\\t\\\"scale\\\": transform.basis.get_scale(),\\n\\t\\t\\t\\\"basis\\\": transform.basis\\n\\t\\t}\\n\\n\\tfunc set_node_global_position(node_or_path: Variant, position_x: float, position_y: float, position_z: float) -> bool:\\n\\t\\tvar node_to_set := null\\n\\t\\tif node_or_path is Node:\\n\\t\\t\\tnode_to_set = node_or_path\\n\\t\\telse:\\n\\t\\t\\tvar path := str(node_or_path)\\n\\t\\t\\tnode_to_set = get_node_or_null(path)\\n\\t\\tif node_to_set == null:\\n\\t\\t\\tpush_error(\\\"Node not found to set position\\\")\\n\\t\\t\\treturn false\\n\\t\\tvar target_position := Vector3(position_x, position_y, position_z)\\n\\t\\tnode_to_set.global_translate(target_position - node_to_set.get_global_transform().origin)\\n\\t\\treturn true\\n\\n\\tfunc translate_node(node_or_path: Variant, offset_x: float = 0.0, offset_y: float = 0.0, offset_z: float = 0.0) -> void:\\n\\t\\tvar node := null\\n\\t\\tif node_or_path is Node:\\n\\t\\t\\tnode = node_or_path\\n\\t\\telse:\\n\\t\\t\\tvar path := str(node_or_path)\\n\\t\\t\\tnode = get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_error(\\\"Node not found to translate\\\")\\n\\t\\t\\treturn\\n\\t\\tvar offset := Vector3(offset_x, offset_y, offset_z)\\n\\t\\tnode.global_translate(offset)\\n\\n\\tfunc inspect_csg_combiner(node_path: String) -> Array[Dictionary]:\\n\\t\\tvar csg_node := get_node_or_null(node_path)\\n\\t\\tif csg_node == null:\\n\\t\\t\\tpush_warning(\\\"CSGCombiner not found at path: \\\" + node_path)\\n\\t\\t\\treturn []\\n\\t\\tvar children := csg_node.get_children()\\n\\t\\tvar info_list := []\\n\\t\\tfor child in children:\\n\\t\\t\\tvar dict := {}\\n\\t\\t\\tif child is CSGBox3D:\\n\\t\\t\\t\\tdict[\\\"type\\\"] = \\\"CSGBox3D\\\"\\n\\t\\t\\t\\tdict[\\\"name\\\"] = child.name\\n\\t\\t\\t\\tdict[\\\"position\\\"] = child.position\\n\\t\\t\\t\\tdict[\\\"size\\\"] = child.size\\n\\t\\t\\t\\tdict[\\\"offset\\\"] = child.offset\\n\\t\\t\\telif child is CSGCombiner2D or child is CSGPolygon:\\n\\t\\t\\t\\tdict[\\\"type\\\"] = child.get_class()\\n\\t\\t\\t\\tdict[\\\"name\\\"] = child.name\\n\\t\\t\\tinfo_list.append(dict)\\n\\t\\treturn info_list\\n\\n\\tfunc find_nodes_by_class(class_name: String, group_path: String = \\\"\\\") -> Array[String]:\\n\\t\\tvar search_path := group_path.strip_edges() if not group_path.is_empty() else \\\".\\\"\\n\\t\\tvar nodes := []\\n\\t\\tfor i in get_node_count():\\n\\t\\t\\tvar node := get_node(i)\\n\\t\\t\\tif node != null and is_class_name(node, class_name):\\n\\t\\t\\t\\tnodes.append(node.path)\\n\\t\\treturn nodes\\n\\n\\tfunc convert_local_to_global(local_point: Vector3, reference_node: Variant) -> Vector3:\\n\\t\\tvar node := null\\n\\t\\tif reference_node is Node:\\n\\t\\t\\tnode = reference_node\\n\\t\\telse:\\n\\t\\t\\tvar path := str(reference_node)\\n\\t\\t\\tnode = get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_warning(\\\"Reference node not found for conversion\\\")\\n\\t\\t\\treturn local_point\\n\\t\\treturn node.global_transform.xform(local_point)\\n\\n\\tfunc convert_global_to_local(global_point: Vector3, reference_node: Variant) -> Vector3:\\n\\t\\tvar node := null\\n\\t\\tif reference_node is Node:\\n\\t\\t\\tnode = reference_node\\n\\t\\telse:\\n\\t\\t\\tvar path := str(reference_node)\\n\\t\\t\\tnode = get_node_or_null(path)\\n\\t\\tif node == null:\\n\\t\\t\\tpush_warning(\\\"Reference node not found for conversion\\\")\\n\\t\\t\\treturn global_point\\n\\t\\treturn node.global_transform.xform(global_point).inverse()\\n\"}",
