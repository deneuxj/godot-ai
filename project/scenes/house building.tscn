"arguments": "{\"script_content\":\"_ = \\\"Apply Stucco material to all outer walls using MAISON_DROIT as the source.\\\"\\n\\n# List of outer wall nodes to update\\ntarget_names = [\\n    \\\"MAISON_AVANT\\\",\\n    \\\"GARAGE_GAUCHE\\\",\\n    \\\"CELIER-EXTERIEUR\\\",\\n    \\\"CHAMBRES_ARRIERE\\\",\\n    \\\"SALLE_A_MANGER_ARRIERE\\\",\\n    \\\"GARAGE_AVANT\\\",\\n    \\\"GARAGE_ARRIERE\\\"\\n]\\n\\n# Find the source node and its material\\nsource_node = get_node_or_null(\\\"../Walls/MAISON_DROIT\\\")\\nif not source_node:\\n    source_node = get_node_or_null(\\\"../MAISON_DROIT\\\")\\n\\nif source_node and \\\"material_override\\\" in source_node:\\n    shared_material = source_node.get(\\\"material_override\\\")\\n    \\n    for name in target_names:\\n        # Try common paths to find the node\\n        target_node = get_node_or_null(\\\"../Walls/\\\" + name)\\n        if not target_node:\\n            target_node = get_node_or_null(\\\"../\\\" + name)\\n            \\n        if target_node and \\\"material_override\\\" in target_node:\\n            target_node.set(\\\"material_override\\\", shared_material)\\nelse:\\n    print(\\\"Source node MAISON_DROIT not found or does not have a material_override.\\\")\\n\"}",
"name": "execute_script"
},
