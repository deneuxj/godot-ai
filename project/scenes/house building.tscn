```gdscript
var source_name = \"MAISON_DROIT\"
var target_names = [\"MAISON_AVANT\", \"GARAGE_GAUCHE\", \"CELIER-EXTERIEUR\", \"CHAMBRES_ARRIERE\", \"SALLE_A_MANGER_ARRIERE\"]

# Find source node and its material
var source_node = get_node_or_null(\"../Walls/\" + source_name)
if not source_node:
    source_node = get_node_or_null(\"../\" + source_name)

if source_node and \"material_override\" in source_node:
    var material = source_node.material_override
    for name in target_names:
        var target_node = get_node_or_null(\"../Walls/\" + name)
        if not target_node:
            target_node = get_node_or_null(\"../\" + name)
        
        if target_node and \"material_override\" in target_node:
            target_node.material_override = material
```
