"properties": {
"height": {
"description": "Optional custom height",
"type": "number"
},
"offset": {
"description": "Position relative to start",
"type": "number"
},
"type": {
"enum": ["door", "window"],
"type": "string"
},
"width": {
"type": "number"
},
"y_offset": {
"description": "Optional vertical offset from floor",
"type": "number"
