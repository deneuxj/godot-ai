"description": "Set the global position (world coordinates) of a node.",
"name": "set_node_global_position",
"parameters": {
"properties": {
"node_path": {
"description": "Path to the node",
"type": "string"
},
"position_x": {
"description": "New X coordinate",
"type": "number"
},
"position_y": {
