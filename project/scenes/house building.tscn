"class_name": {
"description": "Class name to search for (e.g., 'CSGCombiner3D', 'Wall_Generated')",
"type": "string"
},
"group_path": {
"description": "Optional group path to limit the search",
"type": "string"
}
},
"type": "object"
}
},
"type": "function"
}])
